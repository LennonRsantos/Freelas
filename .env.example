# Supabase: Project Settings → API.
# Sem estas variáveis o app mostra uma tela pedindo configuração.
# Use só a chave publishable (sb_publishable_...). Nunca a secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demonstração com dados de exemplo (vagas, pessoas e avaliações inventadas),
# salvos só no navegador. Só vale quando o Supabase NÃO está configurado.
# NEXT_PUBLIC_DEMO=true
